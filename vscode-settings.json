{
  "[csharp]": {
    "editor.formatOnSave": true,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[dart]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
    "editor.formatOnSave": true,
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[go]": {
    "editor.formatOnSave": true,
  },
  "[handlebars]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.sortImports": "explicit",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascriptreact]": {
    "editor.codeActionsOnSave": {
      "source.sortImports": "explicit",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
  },
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true,
  },
  "[prisma]": {
    "editor.formatOnSave": true,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[sql]": {
    "editor.formatOnSave": true,
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg",
    "editor.formatOnSave": true,
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.sortImports": "explicit",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.sortImports": "explicit",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[vue]": {
    "editor.codeActionsOnSave": {
      "source.sortImports": "explicit",
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml",
    "editor.formatOnSave": true,
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "biome.suggestInstallingGlobally": false,
  "chat.disableAIFeatures": true,
  "cSpell.enabledFileTypes": {
    "*": false,
    "prisma": true,
    "sql": true,
  },
  "cSpell.showInRuler": false,
  "cSpell.useCustomDecorations": true,
  "cSpell.userWords": [
    "autoincrement",
    "dbgenerated",
    "simb",
    "tobs",
    "varchar",
  ],
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.env": {
    "CHROME_EXECUTABLE": "/Applications/Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta",
  },
  "dart.flutterSdkPath": "~/flutter",
  "dbcode.ai.inlineCompletion": false,
  "dbcode.connections": [],
  "dbcode.resultLocation": "beside",
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.maxComputationTime": 0,
  "diffEditor.renderSideBySide": true,
  "editor.detectIndentation": true,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 16,
  "editor.formatOnPaste": false,
  "editor.inlineSuggest.enabled": true,
  "editor.largeFileOptimizations": false,
  "editor.linkedEditing": true,
  "editor.maxTokenizationLineLength": 900000,
  "editor.minimap.enabled": false,
  "editor.snippetSuggestions": "top",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "off",
  "emmet.includeLanguages": {
    "blade": "html",
  },
  "eslint.useFlatConfig": true,
  "git.autofetch": true,
  "git.repositoryScanMaxDepth": 4,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false,
  },
  "github.copilot.selectedCompletionModel": "",
  "gitlens.mode.active": "review",
  "gitlens.sortBranchesBy": "name:desc",
  "gitlens.views.branches.branches.layout": "list",
  "gitlens.views.commits.files.layout": "tree",
  "gitlens.views.scm.grouped.hiddenViews": {
    "branches": false,
    "commits": false,
    "contributors": true,
    "fileHistory": false,
    "launchpad": true,
    "remotes": false,
    "repositories": true,
    "searchAndCompare": false,
    "stashes": false,
    "tags": false,
    "worktrees": false,
  },
  "gitlens.views.scm.grouped.views": {
    "branches": true,
    "commits": true,
    "contributors": true,
    "fileHistory": true,
    "launchpad": false,
    "remotes": true,
    "repositories": true,
    "searchAndCompare": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
  },
  "intelephense.codeLens.implementations.enable": true,
  "intelephense.codeLens.overrides.enable": true,
  "intelephense.codeLens.parent.enable": true,
  "intelephense.codeLens.references.enable": true,
  "intelephense.codeLens.usages.enable": true,
  "intelephense.environment.phpVersion": "8.3.0",
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/.history/**",
    "**/vendor/**/vendor/**",
  ],
  "intelephense.telemetry.enabled": false,
  "java.referencesCodeLens.enabled": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "json.schemaDownload.trustedDomains": {
    "https://models.dev/": true,
    "https://opencode.ai/": true,
    "https://raw.githubusercontent.com/": true,
  },
  "laravel-pint.enable": true,
  "markdown.preview.scrollEditorWithPreview": false,
  "phpcs.showSources": true,
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "crash",
  "todo-tree.tree.expanded": true,
  "turboConsoleLog.addSemicolonInTheEnd": true,
  "turboConsoleLog.includeFilename": true,
  "turboConsoleLog.includeLineNum": true,
  "turboConsoleLog.isTurboTelemetryEnabled": false,
  "turboConsoleLog.logMessagePrefix": "🪵",
  "turboConsoleLog.logMessageSuffix": " => ",
  "vsicons.dontShowNewVersionMessage": true,
  "window.autoDetectColorScheme": true,
  "window.title": "${dirty}${rootName}${separator}${activeEditorShort}${separator}${profileName}${separator}",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {},
  "workbench.colorTheme": "Atom One Dark",
  "workbench.iconTheme": "vscode-icons",
  "workbench.preferredDarkColorTheme": "Atom One Dark",
  "workbench.preferredLightColorTheme": "Atom One Light",
  "workbench.sideBar.location": "left",
}
